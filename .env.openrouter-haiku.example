# Template for OpenRouter + Claude Haiku 4.5.
# To use: cp .env.openrouter-haiku.example .env.openrouter-haiku, fill the key,
# then: cp .env.openrouter-haiku .env.local && npm run dev
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-REPLACE_ME
LLM_MODEL=anthropic/claude-haiku-4-5
LLM_STRUCTURED_OUTPUT=json_schema
