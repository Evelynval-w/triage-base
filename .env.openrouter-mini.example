# Template for OpenRouter + GPT-4o-mini.
# To use: cp .env.openrouter-mini.example .env.openrouter-mini, fill the key,
# then: cp .env.openrouter-mini .env.local && npm run dev
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-REPLACE_ME
LLM_MODEL=openai/gpt-4o-mini
LLM_STRUCTURED_OUTPUT=json_schema
